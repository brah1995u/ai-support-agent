# Model provider: auto (Claude if a key is set, else a local server), anthropic or local.
LLM_PROVIDER=auto

# Claude API key.
ANTHROPIC_API_KEY=
# Model and thinking effort for the support agent.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

# Local OpenAI-compatible server (Ollama by default: `ollama pull qwen2.5:7b`).
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b

# Empty = embedded Postgres (PGlite) in .data/pglite, no Docker needed.
# Any Postgres with pgvector works, e.g. docker compose up -d:
# DATABASE_URL=postgres://nimbus:nimbus@localhost:5433/nimbus
DATABASE_URL=

# Local multilingual embeddings (transformers.js). "off" = full-text search only.
EMBEDDINGS=local

# Protects /dashboard and the operator API on public deployments.
OPERATOR_TOKEN=
